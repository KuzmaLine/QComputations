\PYG{+w}{    }\PYG{n+nt}{\PYGZdq{}filename\PYGZdq{}}\PYG{p}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}filename\PYGZdq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// название файла для результата gif}
\PYG{+w}{    }\PYG{n+nt}{\PYGZdq{}width\PYGZdq{}}\PYG{p}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}19\PYGZdq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// Ширина файла (в 100 пикселях)}
\PYG{+w}{    }\PYG{n+nt}{\PYGZdq{}height\PYGZdq{}}\PYG{p}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}10\PYGZdq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// Высота графика (в 100 пикселях)}
\PYG{+w}{    }\PYG{n+nt}{\PYGZdq{}dirs\PYGZdq{}}\PYG{p}{:}\PYG{+w}{ }\PYG{l+s+s2}{\PYGZdq{}*\PYGZdq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{c+c1}{// Какие директории нужно обработать, выбор происходит также}
